        <style>
          <style-rule element='mark'>
            <encoding attr='size-bar' field='[federated.18ah9my0jhemz212dt32y1eiq4dc].[sum:Read Count:qk]' field-type='quantitative' max-size='1' min-size='0.005' type='centersize' />
            <encoding attr='color' field='[federated.18ah9my0jhemz212dt32y1eiq4dc].[sum:Number of Pages:qk]' palette='green_10_0' type='interpolated' />
          </style-rule>
          <style-rule element='legend-title-text'>
            <format attr='color' field='[federated.18ah9my0jhemz212dt32y1eiq4dc].[sum:Number of Pages:qk]' value='Pages Read per Year&#10;'>
