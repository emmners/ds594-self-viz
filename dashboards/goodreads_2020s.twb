      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='goodreads_library_export' name='federated.18ah9my0jhemz212dt32y1eiq4dc' />
          </datasources>
          <datasource-dependencies datasource='federated.18ah9my0jhemz212dt32y1eiq4dc'>
            <column datatype='date' name='[Date Read]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Number of Pages]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Read Count]' role='measure' type='quantitative' />
            <column-instance column='[Number of Pages]' derivation='Sum' name='[sum:Number of Pages:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Read Count]' derivation='Sum' name='[sum:Read Count:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Date Read]' derivation='Year-Trunc' name='[tyr:Date Read:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.18ah9my0jhemz212dt32y1eiq4dc].[tyr:Date Read:ok]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[tyr:Date Read:ok]' />
              <groupfilter function='member' level='[tyr:Date Read:ok]' member='%null%' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.18ah9my0jhemz212dt32y1eiq4dc].[tyr:Date Read:ok]</column>
